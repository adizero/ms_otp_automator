{
  "manifest_version": 3,
  "name": "MS OTP Automator",
  "version": "1.0",
  "description": "Automatically fills Microsoft MFA TOTP codes using oathtool",
  "browser_specific_settings": {
    "gecko": {
      "id": "ms-otp-automator@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://login.microsoftonline.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MS OTP Automator"
  }
}
